# Firebase configuration for the contact form.
#
# Used by the Flutter web app and by the regional Jekyll sites (nasim.pk,
# nasim.us, nasim.ae) — all four surfaces write into the same Firestore
# collection, so one project serves everything.
#
# Copy this file to `.env` and fill in your project's values: Firebase console →
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
# The same six names are used as repository secrets by
# .github/workflows/flutter-web.yml, so CI and local builds stay in sync.
#
# These are the *public* client config values, not credentials — they ship in
# the JavaScript either way. What protects the collection is firestore.rules
# (create-only for the `contacts` collection, no reads) and, optionally,
# restricting this API key to the Firestore API + your referrers in the Google
# Cloud console.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Flutter builds read the file directly:
#
#   flutter run -d chrome --dart-define-from-file=.env
#   flutter build web --release --dart-define-from-file=.env
#
# For local Jekyll builds, write the same values into the git-ignored
# content/<region>/assets/js/firebase-config.js as
#
#   window.FIREBASE_CONFIG = { apiKey: "...", projectId: "...", ... };
#
# CI does that automatically for each region before `jekyll build`.
